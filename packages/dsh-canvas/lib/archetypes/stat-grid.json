{
  "id": "stat-grid",
  "title": "Stat grid",
  "description": "A row of framed cells with one big number and one caption each, sharing a single baseline - reaches for a release note or a summary where the numbers are the argument.",
  "presets": [
    "github-social",
    "og",
    "linkedin-post"
  ],
  "document": {
    "title": "Stat grid",
    "preset": "github-social",
    "canvas": {
      "background": "surface"
    },
    "tokens": {
      "color": {
        "ink": "#F8FAFC",
        "muted": "#94A3B8",
        "accent": "#4D6BFE",
        "surface": "#0B0E14"
      },
      "font": {
        "display": "Space Grotesk",
        "text": "Inter",
        "mono": "system"
      },
      "scale": {
        "display": 76,
        "title": 40,
        "body": 24,
        "caption": 15
      },
      "space": 8,
