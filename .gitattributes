# Line endings the tooling depends on.
#
# EVERYTHING IS LF UNLESS A LATER RULE SAYS OTHERWISE. This file used to name
# only the trees whose bytes are hashed, which left every other text file at the
# mercy of the checker-out's core.autocrlf - and that is not a cosmetic
# difference here, for three reasons:
#
#   1. A DISTRIBUTION ships text files that are compared by hash. The
#      distributer records a sha256 per shipped file and the release publishes
#      SHA256SUMS.txt, so "the zip you downloaded" and "the commit it came from"
#      have to agree byte for byte. With autocrlf=true a fresh Windows checkout
#      materialised 177 of these files as CRLF, so a recipient verifying a file
#      against the repository would see a difference that is not a difference.
#   2. Every pinned tree below is pinned for exactly this reason already, and
#      those local rules cannot help a file nobody named.
#   3. LF is what the repository STORES either way - git normalises on commit -
#      so this rule only stops the checkout from disagreeing with the commit.
#
# The batch and cmd files are the deliberate exception, and because the LAST
# matching rule wins, their `eol=crlf` lines sit BELOW this one on purpose.
* text=auto eol=lf

# A CRLF shebang breaks `./install.sh` on macOS/Linux, so shell scripts are
# pinned to LF no matter which OS checks the repo out. (Kept explicit even
# though the catch-all above already covers it: it is the rule that must not be
# lost if the catch-all is ever narrowed.)
*.sh text eol=lf

# Batch files are the Windows launchers; CRLF is what cmd.exe expects. *.cmd is
# listed for the same reason: scripts/console/adapt.cmd is the `call`ed console
# helper every entry point shares, and a launcher whose line endings depend on
# who checked it out is a launcher that works on one machine.
*.bat text eol=crlf
*.cmd text eol=crlf

# The forked browser bundles are GENERATED and byte-compared by
# scripts/sync-vendored.ps1 (-Check hashes the working copy). With git's
# autocrlf the Windows checkout would rewrite them to CRLF and report phantom
# drift, so they are pinned to LF too.
packages/*/lib/client.js text eol=lf

# The vendored pdf.js tree is GENERATED and byte-hashed by
# packages/dsh-pdf/vendor/build.mjs --check (every file's sha256 plus a digest
# over each tree, recorded in lib/vendor/VERSION.json), so its TEXT files are
# pinned to LF for exactly the reason the forked bundles above are: a Windows
# checkout would rewrite them to CRLF and report phantom drift - and the LICENSE
# files live INSIDE the hashed cMap, standard-font and wasm trees, so converting
# them would change a tree digest too. The .bcmap, .pfb/.ttf and .wasm binaries
# are detected as binary and are never touched.
packages/dsh-pdf/lib/vendor/*.mjs text eol=lf
packages/dsh-pdf/lib/vendor/VERSION.json text eol=lf
packages/dsh-pdf/lib/vendor/LICENSE text eol=lf
packages/dsh-pdf/lib/vendor/cmaps/LICENSE text eol=lf
packages/dsh-pdf/lib/vendor/standard_fonts/LICENSE_* text eol=lf
packages/dsh-pdf/lib/vendor/wasm/LICENSE_* text eol=lf
packages/dsh-pdf/lib/vendor/wasm/*.js text eol=lf

# dsh-canvas's vendored font tree is the same contract: VERSION.json records a
# sha256 per file and per licence text, and vendor/build.mjs --check re-reads them
# offline - so its TEXT files (the two OFL licence texts and the record itself)
# are pinned to LF here as well as by the catch-all above. The .woff2 subsets are
# binary and are never touched.
packages/dsh-canvas/lib/vendor/fonts/*.txt text eol=lf
packages/dsh-canvas/lib/vendor/fonts/VERSION.json text eol=lf

# dsh-canvas's vendored Excalidraw surface is GENERATED and byte-hashed by
# packages/dsh-canvas/vendor/excalidraw/build.mjs --check (a sha256 per artifact,
# a licence hash and a digest, all recorded in lib/vendor/excalidraw/VERSION.json),
# so its TEXT files are pinned to LF for exactly the reason the trees above are: a
# Windows checkout would rewrite the 3 MiB bundle to CRLF and report phantom drift
# on the one file whose entire point is that its bytes are pinned. The stylesheet,
# the three licence texts and the record are the same contract.
packages/dsh-canvas/lib/vendor/excalidraw/*.js text eol=lf
packages/dsh-canvas/lib/vendor/excalidraw/*.css text eol=lf
packages/dsh-canvas/lib/vendor/excalidraw/*.txt text eol=lf
packages/dsh-canvas/lib/vendor/excalidraw/VERSION.json text eol=lf
