{
  "name": "vncode",
  "version": "0.1.1",
  "private": true,
  "description": "Personal plugin pack for DeepSeek Harness (Windows/MacOS/Linux). Installs into the raw web/CLI profile only (npx @deepseek-ai/dsh web).",
  "license": "AGPL-3.0-only",
  "scripts": {
    "install:web": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup/install-all.ps1",
    "uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup/uninstall-all.ps1",
    "logo": "node scripts/tools/logo/render.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
